{
  "tools": [
    {
      "name": "route_prompt",
      "title": "Route Prompt",
      "description": "Return deterministic, prompt-free SkillMap recommendations from one approved revision.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          "max": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "skillId": {
            "type": "string",
            "pattern": "^sk_[A-Za-z0-9_-]{43}$"
          }
        },
        "required": [
          "prompt"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "const": "skillmap.api-response"
          },
          "schemaVersion": {
            "type": "number",
            "const": 1
          },
          "ok": {
            "type": "boolean",
            "const": true
          },
          "requestId": {
            "type": "string",
            "minLength": 1
          },
          "servingRevision": {
            "anyOf": [
              {
                "$ref": "#/definitions/SkillMapRevisionRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "currentRevision": {
            "anyOf": [
              {
                "$ref": "#/definitions/SkillMapRevisionRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "compatibility": {
            "type": "string",
            "enum": [
              "compatible",
              "degraded",
              "upgrade-required",
              "client-too-new",
              "incompatible"
            ]
          },
          "data": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "skillmap.route-result"
              },
              "schemaVersion": {
                "type": "number",
                "const": 2
              },
              "routeId": {
                "type": "string"
              },
              "createdAt": {
                "type": "string"
              },
              "promptStored": {
                "type": "boolean",
                "const": false
              },
              "decision": {
                "type": "object",
                "properties": {},
                "additionalProperties": {}
              },
              "decisionDigest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "latencyMs": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "kind",
              "schemaVersion",
              "routeId",
              "createdAt",
              "promptStored",
              "decision",
              "decisionDigest",
              "latencyMs"
