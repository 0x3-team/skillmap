                      "maximum": 9007199254740991
                    },
                    "assetCount": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "trust": {
                      "type": "string",
                      "enum": [
                        "parsed",
                        "invalid-frontmatter"
                      ]
                    }
                  },
                  "required": [
                    "skillId",
                    "displayName",
                    "contentRevision",
                    "tier",
                    "routeEligible",
                    "qualifiedExplicitAllowed",
                    "variantState",
                    "hasScripts",
                    "referenceCount",
                    "assetCount",
                    "trust"
                  ],
                  "additionalProperties": false
                }
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "hasMore": {
                "type": "boolean"
              },
              "nextCursor": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sortKey": {
                "type": "string",
                "const": "stable-v1"
              }
            },
