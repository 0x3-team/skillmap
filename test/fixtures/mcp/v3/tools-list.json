        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "definitions": {
          "SkillMapRevisionRef": {
            "type": "object",
            "properties": {
              "workspaceId": {
                "type": "string"
              },
              "revisionId": {
                "type": "string"
              },
              "workspaceRevision": {
                "type": "string"
              },
              "effectiveDigest": {
                "anyOf": [
                  {
                    "type": "string"
