{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillmap.dev/contracts/route-result/v2.schema.json",
  "title": "SkillMap Route Result v2",
  "description": "The deterministic, revision-bound route object emitted by CLI, hook, MCP, and the loopback API. It never contains the input prompt or local paths.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "routeId", "createdAt", "promptStored", "decision", "decisionDigest", "latencyMs"],
  "properties": {
    "kind": { "const": "skillmap.route-result" },
    "schemaVersion": { "const": 2 },
    "routeId": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/RouteId" },
    "createdAt": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/IsoTimestamp" },
    "promptStored": { "const": false },
    "decision": { "$ref": "#/$defs/RouteDecision" },
    "decisionDigest": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/Sha256Digest" },
    "latencyMs": { "type": "number", "minimum": 0, "maximum": 60000 }
  },
  "$defs": {
    "MachineCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "Recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skillId", "displayName", "score", "tier", "reasonCodes"],
      "properties": {
        "skillId": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/SkillId" },
        "displayName": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/BoundedLabel" },
        "score": { "type": "number", "minimum": -10000, "maximum": 10000 },
        "tier": { "enum": ["active-default", "specialist", "explicit-only", "archived", "blocked"] },
        "reasonCodes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/MachineCode" }
        }
      }
    },
    "Exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "reasonCode"],
      "properties": {
        "skillId": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/SkillId" },
        "displayName": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/BoundedLabel" },
        "reasonCode": { "$ref": "#/$defs/MachineCode" }
      }
    },
    "RouteDecision": {
      "$comment": "decisionDigest hashes this complete object and therefore excludes routeId, createdAt, the prompt input, and latencyMs.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schemaVersion", "revision", "servingMode", "recommendations", "exclusions", "hookText", "warningState", "warningCodes"],
      "properties": {
        "kind": { "const": "skillmap.route-decision" },
        "schemaVersion": { "const": 2 },
        "revision": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/RevisionRef" },
        "servingMode": { "enum": ["current", "last-known-good"] },
        "recommendations": {
          "type": "array",
          "maxItems": 10,
          "items": { "$ref": "#/$defs/Recommendation" }
        },
        "exclusions": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/Exclusion" }
        },
        "hookText": { "type": "string", "maxLength": 500 },
        "warningState": { "enum": ["none", "degraded", "blocked"] },
        "warningCodes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/MachineCode" }
        }
      }
    }
  }
}
