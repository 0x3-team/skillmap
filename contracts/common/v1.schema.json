{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillmap.dev/contracts/common/v1.schema.json",
  "title": "SkillMap Common Contract Definitions v1",
  "description": "Shared bounded primitives for SkillMap wire and persisted-state contracts.",
  "$defs": {
    "Sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "HmacSha256Digest": {
      "type": "string",
      "pattern": "^hmac-sha256:[0-9a-f]{64}$"
    },
    "Uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "SkillId": {
      "type": "string",
      "pattern": "^sk_[A-Za-z0-9_-]{43}$"
    },
    "RevisionId": {
      "type": "string",
      "pattern": "^r[0-9]{20}-[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "RequestId": {
      "$ref": "#/$defs/Uuid"
    },
    "RouteId": {
      "$ref": "#/$defs/Uuid"
    },
    "JobId": {
      "$ref": "#/$defs/Uuid"
    },
    "EventId": {
      "$ref": "#/$defs/Uuid"
    },
    "FeedbackId": {
      "$ref": "#/$defs/Uuid"
    },
    "IsoTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
      "maxLength": 40
    },
    "BoundedLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029]+$"
    },
    "BoundedMessage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "SafeRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)[^\\u0000-\\u001F\\u007F]+$"
    },
    "Producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "version": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "CompatibilityState": {
      "enum": ["compatible", "upgrade-required", "client-too-new", "degraded"]
    },
    "Compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "minReaderSchemaVersion", "maxReaderSchemaVersion"],
      "properties": {
        "state": { "$ref": "#/$defs/CompatibilityState" },
        "minReaderSchemaVersion": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "maxReaderSchemaVersion": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "RevisionRef": {
      "$comment": "effectiveDigest is the exact immutable effective.json artifact-byte digest. effectiveRevisionDigest is the semantic computeEffectiveRevisionDigest value. Both are null when no approved effective projection exists; approved routing requires both non-null.",
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaceId", "revisionId", "workspaceRevision", "effectiveDigest", "effectiveRevisionDigest"],
      "properties": {
        "workspaceId": { "$ref": "#/$defs/Uuid" },
        "revisionId": { "$ref": "#/$defs/RevisionId" },
        "workspaceRevision": { "$ref": "#/$defs/Sha256Digest" },
        "effectiveDigest": {
          "oneOf": [
            { "$ref": "#/$defs/Sha256Digest" },
            { "type": "null" }
          ]
        },
        "effectiveRevisionDigest": {
          "oneOf": [
            { "$ref": "#/$defs/Sha256Digest" },
            { "type": "null" }
          ]
        }
      }
    },
    "ActorRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["local-user", "device", "system"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "RedactionClassification": {
      "enum": ["shareable-redacted", "metadata-only", "local-sensitive"]
    },
    "ValidationIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "code"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 512 },
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,79}$" }
      }
    },
    "RevisionConflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedRevision", "currentRevision"],
      "properties": {
        "expectedRevision": { "$ref": "#/$defs/RevisionRef" },
        "currentRevision": { "$ref": "#/$defs/RevisionRef" }
      }
    },
    "SafeError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,79}$" },
        "message": { "$ref": "#/$defs/BoundedMessage" },
        "retryable": { "type": "boolean" },
        "issues": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/ValidationIssue" }
        },
        "conflict": { "$ref": "#/$defs/RevisionConflict" }
      }
    },
    "Pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit", "nextCursor", "hasMore", "stableSortKey"],
      "properties": {
        "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
        "nextCursor": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 512 },
            { "type": "null" }
          ]
        },
        "hasMore": { "type": "boolean" },
        "stableSortKey": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    }
  }
}
