{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillmap.dev/contracts/eval-suite/v3.schema.json",
  "title": "SkillMap Qualified Eval Suite v3",
  "description": "Qualified-identity eval data with explicit case provenance and a non-self-referential dataset digest.",
  "$comment": "datasetDigest hashes schemaVersion, suiteId, name, provenance, baseline, and cases after canonicalization; it excludes datasetDigest, payloadDigest, createdAt, and updatedAt. frozenCaseSetDigest separately binds the ordered metric-affecting case inputs without circular provenance. Provenance, baseline, and holdout freeze remain explicit operator-reviewed local assertions, not independent attestations; public release still requires owner review. Quotas, holdout ratio, prompt leakage, case ID uniqueness, and digest equality are semantic checks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "suiteId", "name", "createdAt", "updatedAt", "datasetDigest", "provenance", "baseline", "cases", "redactionClassification", "payloadDigest"],
  "properties": {
    "kind": { "const": "skillmap.eval-suite" },
    "schemaVersion": { "const": 3 },
    "suiteId": { "type": "string", "pattern": "^evalsuite_[A-Za-z0-9_-]{8,80}$" },
    "name": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/BoundedLabel" },
    "createdAt": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/IsoTimestamp" },
    "updatedAt": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/IsoTimestamp" },
    "datasetDigest": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/Sha256Digest" },
    "provenance": { "$ref": "#/$defs/DatasetProvenance" },
    "baseline": { "$ref": "#/$defs/Baseline" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/EvalCase" }
    },
    "redactionClassification": { "const": "local-sensitive" },
    "payloadDigest": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/Sha256Digest" }
  },
  "$defs": {
    "Rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "SkillIdList": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/SkillId" }
    },
    "DatasetProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["labelAuthor", "reviewedBy", "sourceClass", "createdAt", "holdoutFrozenAt", "reviewedAt", "deduplicationResult", "holdoutFrozen", "frozenCaseSetDigest"],
      "properties": {
        "labelAuthor": { "type": "string", "minLength": 1, "maxLength": 200 },
        "reviewedBy": { "type": "string", "minLength": 1, "maxLength": 200 },
        "sourceClass": { "enum": ["operator-authored", "observed-redacted", "imported", "synthetic"] },
        "createdAt": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/IsoTimestamp" },
        "holdoutFrozenAt": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/IsoTimestamp" },
        "reviewedAt": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/IsoTimestamp" },
        "deduplicationResult": { "const": "passed" },
        "holdoutFrozen": { "const": true },
        "frozenCaseSetDigest": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/Sha256Digest" }
      }
    },
    "CaseLabelProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "sourceClass", "createdAt", "reviewedAt"],
      "properties": {
        "author": { "type": "string", "minLength": 1, "maxLength": 200 },
        "sourceClass": { "enum": ["operator-authored", "observed-redacted", "imported", "synthetic"] },
        "createdAt": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/IsoTimestamp" },
        "reviewedAt": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/IsoTimestamp" }
      }
    },
    "Baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top1Rate", "top3Rate", "avoidHits", "abstentionRate", "meanAdvisoryBytes", "provenance"],
      "properties": {
        "top1Rate": { "$ref": "#/$defs/Rate" },
        "top3Rate": { "$ref": "#/$defs/Rate" },
        "avoidHits": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "abstentionRate": { "$ref": "#/$defs/Rate" },
        "meanAdvisoryBytes": { "type": "number", "minimum": 0, "maximum": 1048576 },
        "provenance": { "$ref": "#/$defs/BaselineProvenance" }
      }
    },
    "BaselineProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceKind", "completedAt", "caseSetDigest", "sourceRevision"],
      "properties": {
        "sourceKind": { "enum": ["approved-effective-revision", "operator-declared-no-skillmap"] },
        "completedAt": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/IsoTimestamp" },
        "caseSetDigest": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/Sha256Digest" },
        "sourceRevision": {
          "anyOf": [
            { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/RevisionRef" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "sourceKind": { "const": "approved-effective-revision" } }, "required": ["sourceKind"] },
          "then": { "properties": { "sourceRevision": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/RevisionRef" } } }
        },
        {
          "if": { "properties": { "sourceKind": { "const": "operator-declared-no-skillmap" } }, "required": ["sourceKind"] },
          "then": { "properties": { "sourceRevision": { "type": "null" } } }
        }
      ]
    },
    "EvalCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "prompt", "expectedSkillIds", "avoidSkillIds", "primaryCaseType", "membership", "labelProvenance"],
      "properties": {
        "caseId": { "type": "string", "pattern": "^evalcase_[A-Za-z0-9_-]{8,100}$" },
        "prompt": { "type": "string", "maxLength": 32768 },
        "expectedSkillIds": { "$ref": "#/$defs/SkillIdList" },
        "avoidSkillIds": { "$ref": "#/$defs/SkillIdList" },
        "qualifiedSkillId": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/SkillId" },
        "primaryCaseType": { "enum": ["explicit", "implicit-natural", "multi-skill", "negative-near-miss"] },
        "membership": { "enum": ["train", "holdout"] },
        "labelProvenance": { "$ref": "#/$defs/CaseLabelProvenance" }
      },
      "allOf": [
        {
          "if": { "properties": { "primaryCaseType": { "enum": ["explicit", "implicit-natural"] } }, "required": ["primaryCaseType"] },
          "then": { "properties": { "expectedSkillIds": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "primaryCaseType": { "const": "multi-skill" } }, "required": ["primaryCaseType"] },
          "then": { "properties": { "expectedSkillIds": { "minItems": 2, "maxItems": 3 } } }
        },
        {
          "if": { "properties": { "primaryCaseType": { "const": "negative-near-miss" } }, "required": ["primaryCaseType"] },
          "then": { "properties": { "avoidSkillIds": { "minItems": 1 } } }
        }
      ]
    }
  }
}
