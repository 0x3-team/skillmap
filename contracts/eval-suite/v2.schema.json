{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillmap.dev/contracts/eval-suite/v2.schema.json",
  "title": "SkillMap Eval Suite v2",
  "description": "Strict form of the current display-name-based eval v2 suite. It remains local-sensitive and requires semantic leakage, quota, and ambiguity checks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "provenance", "baseline", "evals"],
  "properties": {
    "version": { "const": 2 },
    "provenance": { "$ref": "#/$defs/Provenance" },
    "baseline": { "$ref": "#/$defs/Baseline" },
    "evals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/EvalCase" }
    }
  },
  "$defs": {
    "Rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "NameList": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["labelAuthor", "sourceClass", "createdAt", "reviewedAt", "deduplicationResult", "holdoutFrozen"],
      "properties": {
        "labelAuthor": { "type": "string", "minLength": 1, "maxLength": 200 },
        "sourceClass": { "type": "string", "minLength": 1, "maxLength": 200 },
        "createdAt": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/IsoTimestamp" },
        "reviewedAt": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/IsoTimestamp" },
        "deduplicationResult": { "enum": ["passed", "failed", "not-run"] },
        "holdoutFrozen": { "type": "boolean" },
        "datasetDigest": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/Sha256Digest" }
      }
    },
    "Baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top1Rate", "top3Rate", "avoidHits", "abstentionRate", "meanAdvisoryBytes"],
      "properties": {
        "top1Rate": { "$ref": "#/$defs/Rate" },
        "top3Rate": { "$ref": "#/$defs/Rate" },
        "avoidHits": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "abstentionRate": { "$ref": "#/$defs/Rate" },
        "meanAdvisoryBytes": { "type": "number", "minimum": 0, "maximum": 1048576 }
      }
    },
    "EvalCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "expected", "primaryCaseType", "membership"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 32768 },
        "expected": { "$ref": "#/$defs/NameList" },
        "avoid": { "$ref": "#/$defs/NameList" },
        "primaryCaseType": { "enum": ["explicit", "implicit-natural", "multi-skill", "negative-near-miss"] },
        "membership": { "enum": ["train", "holdout"] }
      },
      "allOf": [
        {
          "if": { "properties": { "primaryCaseType": { "enum": ["explicit", "implicit-natural"] } }, "required": ["primaryCaseType"] },
          "then": { "properties": { "expected": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "primaryCaseType": { "const": "multi-skill" } }, "required": ["primaryCaseType"] },
          "then": { "properties": { "expected": { "minItems": 2, "maxItems": 3 } } }
        },
        {
          "if": { "properties": { "primaryCaseType": { "const": "negative-near-miss" } }, "required": ["primaryCaseType"] },
          "then": { "required": ["avoid"], "properties": { "avoid": { "minItems": 1 } } }
        }
      ]
    }
  }
}
