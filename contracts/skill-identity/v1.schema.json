{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillmap.dev/contracts/skill-identity/v1.schema.json",
  "title": "SkillMap Qualified Skill Identity Family v1",
  "description": "Local identity state, shareable identity references, and identity migration receipts.",
  "oneOf": [
    { "$ref": "#/$defs/WorkspaceIdentityRegistry" },
    { "$ref": "#/$defs/QualifiedSkillIdentity" },
    { "$ref": "#/$defs/SkillIdentityRef" },
    { "$ref": "#/$defs/IdentityMoveReceipt" },
    { "$ref": "#/$defs/IdentityTombstone" },
    { "$ref": "#/$defs/ApprovedNewIdentityReceipt" }
  ],
  "$defs": {
    "ApprovedRootRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootId", "configuredPath", "realPath", "approvedAt"],
      "properties": {
        "rootId": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/Uuid" },
        "configuredPath": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "realPath": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "approvedAt": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/IsoTimestamp" }
      }
    },
    "WorkspaceIdentityRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schemaVersion", "identityVersion", "workspaceId", "createdAt", "updatedAt", "roots", "redactionClassification"],
      "properties": {
        "kind": { "const": "skillmap.workspace-identity" },
        "schemaVersion": { "const": 1 },
        "identityVersion": { "const": 1 },
        "workspaceId": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/Uuid" },
        "createdAt": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/IsoTimestamp" },
        "updatedAt": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/IsoTimestamp" },
        "roots": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/ApprovedRootRecord" }
        },
        "redactionClassification": { "const": "local-sensitive" }
      }
    },
    "SkillTreeEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "mode", "digest"],
      "properties": {
        "path": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/SafeRelativePath" },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
        "mode": { "type": "integer", "minimum": 0, "maximum": 511 },
        "digest": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/Sha256Digest" }
      }
    },
    "QualifiedSkillIdentity": {
      "$comment": "Runtime semantic validation must NFC-normalize relativePath, derive skillId from identityVersion/rootId/relativePath, verify full-tree contentRevision, and enforce root containment without symlinks.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schemaVersion", "identityVersion", "workspaceId", "rootId", "relativePath", "skillId", "displayName", "contentRevision", "treeEntries", "realPath", "redactionClassification"],
      "properties": {
        "kind": { "const": "skillmap.qualified-skill-identity" },
        "schemaVersion": { "const": 1 },
        "identityVersion": { "const": 1 },
        "workspaceId": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/Uuid" },
        "rootId": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/Uuid" },
        "relativePath": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/SafeRelativePath" },
        "skillId": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/SkillId" },
        "displayName": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/BoundedLabel" },
        "contentRevision": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/Sha256Digest" },
        "treeEntries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/SkillTreeEntry" }
        },
        "realPath": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "redactionClassification": { "const": "local-sensitive" }
      }
    },
    "SkillIdentityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schemaVersion", "skillId", "displayName", "contentRevision"],
      "properties": {
        "kind": { "const": "skillmap.skill-identity-ref" },
        "schemaVersion": { "const": 1 },
        "skillId": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/SkillId" },
        "displayName": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/BoundedLabel" },
        "contentRevision": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/Sha256Digest" }
      }
    },
    "IdentityMoveReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schemaVersion", "fromSkillId", "toSkillId", "displayName", "contentRevision", "actor", "reason", "approvedAt", "receiptDigest"],
      "properties": {
        "kind": { "const": "skillmap.identity-move-receipt" },
        "schemaVersion": { "const": 1 },
        "fromSkillId": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/SkillId" },
        "toSkillId": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/SkillId" },
        "displayName": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/BoundedLabel" },
        "contentRevision": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/Sha256Digest" },
        "actor": { "type": "string", "minLength": 1, "maxLength": 200 },
        "reason": { "type": "string", "minLength": 12, "maxLength": 2000 },
        "approvedAt": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/IsoTimestamp" },
        "receiptDigest": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/Sha256Digest" }
      }
    },
    "IdentityTombstone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schemaVersion", "skillId", "displayName", "contentRevision", "rootId", "relativePath", "removedAt"],
      "properties": {
        "kind": { "const": "skillmap.identity-tombstone" },
        "schemaVersion": { "const": 1 },
        "skillId": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/SkillId" },
        "displayName": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/BoundedLabel" },
        "contentRevision": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/Sha256Digest" },
        "rootId": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/Uuid" },
        "relativePath": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/SafeRelativePath" },
        "removedAt": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/IsoTimestamp" }
      }
    },
    "ApprovedNewIdentityReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schemaVersion", "skillId", "displayName", "contentRevision", "actor", "reason", "approvedAt", "receiptDigest"],
      "properties": {
        "kind": { "const": "skillmap.approved-new-identity-receipt" },
        "schemaVersion": { "const": 1 },
        "skillId": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/SkillId" },
        "displayName": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/BoundedLabel" },
        "contentRevision": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/Sha256Digest" },
        "actor": { "type": "string", "minLength": 1, "maxLength": 200 },
        "reason": { "type": "string", "minLength": 12, "maxLength": 2000 },
        "approvedAt": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/IsoTimestamp" },
        "receiptDigest": { "$ref": "https://skillmap.dev/contracts/common/v1.schema.json#/$defs/Sha256Digest" }
      }
    }
  }
}
