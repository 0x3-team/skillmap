{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/pre-commit-gate.mjs\"",
            "timeout": 390
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd -- \"${CLAUDE_PROJECT_DIR:-.}\" && chunk validate",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
