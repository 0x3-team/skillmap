    { "kind": "public_tuple", "source_diagnostic": "STORAGE_TRANSIENT_BEFORE_DURABLE_BINDING", "source_owner": "Storage", "public_code": "IMPORT_INFRASTRUCTURE_RETRYABLE", "notes": "No object key, bucket, provider, or path detail is disclosed." },
